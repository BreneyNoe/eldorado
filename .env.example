# =====================================================================
# MODÈLE DE CONFIGURATION
# =====================================================================
# 1. Copie ce fichier sous le nom ".env.local" (même dossier).
# 2. Remplis les deux premières valeurs.
# 3. Relance "npm run dev".
#
# ".env.local" n'est jamais envoyé sur GitHub (voir .gitignore).
#
# Toutes les variables commençant par VITE_ finissent dans le code
# envoyé au navigateur : elles sont PUBLIQUES par nature. Ne mets
# jamais ici la clé "secret" de Supabase ni le mot de passe de la base.
# =====================================================================

# Adresse du projet : uniquement https://<projet>.supabase.co
# (si Supabase l'affiche suivie de /rest/v1/, cette fin est ignorée).
# Supabase > bouton "Connect", ou Project Settings > Data API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key
# Elle commence par "sb_publishable_". Elle est faite pour être publique :
# la sécurité repose sur les règles RLS de la base, pas sur cette clé.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Optionnel : les valeurs ci-dessous sont déjà celles par défaut ---

# Style de carte (OpenFreeMap). Changer de fournisseur = changer cette ligne.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Images de la vue satellite. Par défaut : photos aériennes de l'IGN
# (gratuites, sans clé, France uniquement). L'adresse doit contenir {z}, {x}, {y}.
# VITE_SATELLITE_TILES_URL=https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=ORTHOIMAGERY.ORTHOPHOTOS&STYLE=normal&FORMAT=image/jpeg&TILEMATRIXSET=PM&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}

# Service qui transforme des coordonnées en adresse (Nominatim).
# VITE_GEOCODER_URL=https://nominatim.openstreetmap.org

# Chemin de base du site. "/" en local.
# Sur GitHub Pages : "/nom-du-depot/" (sera réglé à l'étape 18).
# VITE_BASE_PATH=/
